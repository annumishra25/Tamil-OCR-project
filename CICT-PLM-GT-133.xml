    <TextRegion id="region_body" type="paragraph" custom="structure {type:main-body;}">
      <Coords points="331,20 2513,20 2513,439 331,439"/>
      <TextLine id="line_body_L1">
        <Coords points="359,30 2499,30 2499,67 359,67"/>
        <Baseline points="359,63 2499,63"/>
        <TextEquiv><Unicode>இல்லைத் தவற் வாக்காயினு மூடுதல் வல்லது வாளிக்கு மா று</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="line_body_L2">
        <Coords points="359,71 2499,71 2499,108 359,108"/>
        <Baseline points="359,104 2499,104"/>
        <TextEquiv><Unicode>ஊடலிற் றோன்று ஞ்சிறுதுனி நல்லளி வாடினும் பாடு பெறு ம</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="line_body_L3">
        <Coords points="359,112 2499,112 2499,149 359,149"/>
        <Baseline points="359,145 2499,145"/>
        <TextEquiv><Unicode>புலத்தலிற் பத்தேணுடுண்டோ நிலத்தொடு நீரியைந் தன்னூர்க த் து</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="line_body_L4">
        <Coords points="359,153 2499,153 2499,190 359,190"/>
        <Baseline points="359,186 2499,186"/>
        <TextEquiv><Unicode>புல்லிவிடாப் புல்வி யுடடோன்றுமெனனுள்ளமுடைக்கும் படை</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="line_body_L5">
        <Coords points="359,194 2499,194 2499,231 359,231"/>
        <Baseline points="359,227 2499,227"/>
        <TextEquiv><Unicode>தவரிலநாயினுந்தா  மவீழவரா மென்றேள் கறலி னுங் கொன்றுடைத் து</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="line_body_L6">
        <Coords points="359,235 2499,235 2499,272 359,272"/>
        <Baseline points="359,268 2499,268"/>
        <TextEquiv><Unicode>உணலிசநுமுண்டதற்லினிது காமம் புணாதலினூட லிநி து</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="line_body_L7">
        <Coords points="359,276 2499,276 2499,313 359,313"/>
        <Baseline points="359,309 2499,309"/>
        <TextEquiv><Unicode>உளடலிற் றேற்றுவ ரவென்றார்  துமநநுங் கூடலிற் காணப்படு ம்</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="line_body_L8">
        <Coords points="359,317 2499,317 2499,354 359,354"/>
        <Baseline points="359,350 2499,350"/>
        <TextEquiv><Unicode>உளடிப் பெருகுவுங் தொல்லொநு துல்வியாப்பக்  கடலிற றேனறிய      ஷப் பு</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="line_body_L9">
        <Coords points="359,358 2499,358 2499,395 359,395"/>
        <Baseline points="359,391 2499,391"/>
        <TextEquiv><Unicode>உளடுக மந்நொ வொளியிழை யாமிரப்ப நீடுகு மன்னோ விர ர்</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="line_body_L10">
        <Coords points="359,399 2499,399 2499,436 359,436"/>
        <Baseline points="359,432 2499,432"/>
        <TextEquiv><Unicode>உளடுதுல காமத்திற் கின் பமதற் கின்பங் கூடிமுயங்கப்  பெறி ன்</Unicode></TextEquiv>
      </TextLine>
