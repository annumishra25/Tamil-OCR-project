{"sample_id": "CICT_line_body_L4", "dataset": "CICT-PLM-GT-133", "source_group_id": "CICT_GT133_FOLIO_87", "folio_id": "87_Recto", "line_id": "line_body_L4", "image_path": "data/processed/cict_gt133_lines/line_007_line_body_L4.png", "image_exists": true, "label_path": "CICT-PLM-GT-133.xml", "transcription": "புல்லிவிடாப் புல்வி யுடடோன்றுமெனனுள்ளமுடைக்கும் படை", "normalized_transcription": "புல்லிவிடாப் புல்வி யுடடோன்றுமெனனுள்ளமுடைக்கும் படை", "data_level": "LINE_LEVEL", "label_status": "VERIFIED_GROUND_TRUTH", "line_type": "paragraph", "reading_order": 0, "split": "external_test", "preprocessing_variant": "raw_crop", "synthetic_variant": "none", "license": "CC BY 4.0 (CICT Chennai)", "notes": "Couplet line from Tirukkural Ch 133 (Kural N/A)"}
{"sample_id": "CICT_line_body_L5", "dataset": "CICT-PLM-GT-133", "source_group_id": "CICT_GT133_FOLIO_87", "folio_id": "87_Recto", "line_id": "line_body_L5", "image_path": "data/processed/cict_gt133_lines/line_008_line_body_L5.png", "image_exists": true, "label_path": "CICT-PLM-GT-133.xml", "transcription": "தவரிலநாயினுந்தா  மவீழவரா மென்றேள் கறலி னுங் கொன்றுடைத் து", "normalized_transcription": "தவரிலநாயினுந்தா மவீழவரா மென்றேள் கறலி னுங் கொன்றுடைத் து", "data_level": "LINE_LEVEL", "label_status": "VERIFIED_GROUND_TRUTH", "line_type": "paragraph", "reading_order": 0, "split": "external_test", "preprocessing_variant": "raw_crop", "synthetic_variant": "none", "license": "CC BY 4.0 (CICT Chennai)", "notes": "Couplet line from Tirukkural Ch 133 (Kural N/A)"}
{"sample_id": "CICT_line_body_L6", "dataset": "CICT-PLM-GT-133", "source_group_id": "CICT_GT133_FOLIO_87", "folio_id": "87_Recto", "line_id": "line_body_L6", "image_path": "data/processed/cict_gt133_lines/line_009_line_body_L6.png", "image_exists": true, "label_path": "CICT-PLM-GT-133.xml", "transcription": "உணலிசநுமுண்டதற்லினிது காமம் புணாதலினூட லிநி து", "normalized_transcription": "உணலிசநுமுண்டதற்லினிது காமம் புணாதலினூட லிநி து", "data_level": "LINE_LEVEL", "label_status": "VERIFIED_GROUND_TRUTH", "line_type": "paragraph", "reading_order": 0, "split": "external_test", "preprocessing_variant": "raw_crop", "synthetic_variant": "none", "license": "CC BY 4.0 (CICT Chennai)", "notes": "Couplet line from Tirukkural Ch 133 (Kural N/A)"}
{"sample_id": "CICT_line_body_L7", "dataset": "CICT-PLM-GT-133", "source_group_id": "CICT_GT133_FOLIO_87", "folio_id": "87_Recto", "line_id": "line_body_L7", "image_path": "data/processed/cict_gt133_lines/line_010_line_body_L7.png", "image_exists": true, "label_path": "CICT-PLM-GT-133.xml", "transcription": "உளடலிற் றேற்றுவ ரவென்றார்  துமநநுங் கூடலிற் காணப்படு ம்", "normalized_transcription": "உளடலிற் றேற்றுவ ரவென்றார் துமநநுங் கூடலிற் காணப்படு ம்", "data_level": "LINE_LEVEL", "label_status": "VERIFIED_GROUND_TRUTH", "line_type": "paragraph", "reading_order": 0, "split": "external_test", "preprocessing_variant": "raw_crop", "synthetic_variant": "none", "license": "CC BY 4.0 (CICT Chennai)", "notes": "Couplet line from Tirukkural Ch 133 (Kural N/A)"}
