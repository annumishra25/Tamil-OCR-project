[
  {
    "source_group_id": "TIRUKKURAL_CH01_K001",
    "work": "Tirukkural",
    "section": "அறத்துப்பால்",
    "chapter": "கடவுள் வாழ்த்து",
    "kural_no": 1,
    "lines": [
      "அகர முதல எழுத்தெல்லாம் ஆதி",
      "பகவன் முதற்றே உலகு"
    ]
  },
  {
    "source_group_id": "TIRUKKURAL_CH01_K002",
    "work": "Tirukkural",
    "section": "அறத்துப்பால்",
    "chapter": "கடவுள் வாழ்த்து",
    "kural_no": 2,
    "lines": [
      "கற்றதனால் ஆய பயனென்கொல் வாலறிவன்",
      "நற்றாள் தொழாஅர் எனின்"
    ]
  },
  {
    "source_group_id": "TIRUKKURAL_CH01_K003",
    "work": "Tirukkural",
    "section": "அறத்துப்பால்",
    "chapter": "கடவுள் வாழ்த்து",
    "kural_no": 3,
    "lines": [
      "மலர்மிசை ஏகினான் மாணடி சேர்ந்தார்",
      "நிலமிசை நீடுவாழ் வார்"
    ]
  },
  {
    "source_group_id": "TIRUKKURAL_CH01_K004",
    "work": "Tirukkural",
    "section": "அறத்துப்பால்",
    "chapter": "கடவுள் வாழ்த்து",
    "kural_no": 4,
    "lines": [
      "வேண்டுதல் வேண்டாமை இலானடி சேர்ந்தார்க்கு",
      "யாண்டும் இடும்பை இல"
    ]
  },
  {
    "source_group_id": "TIRUKKURAL_CH01_K005",
    "work": "Tirukkural",
    "section": "அறத்துப்பால்",
    "chapter": "கடவுள் வாழ்த்து",
    "kural_no": 5,
    "lines": [
      "இருள்சேர் இருவினையும் சேரா இறைவன்",
      "பொருள்சேர் புகழ்புரிந்தார் மாட்டு"
    ]
  },
  {
    "source_group_id": "TIRUKKURAL_CH01_K006",
    "work": "Tirukkural",
    "section": "அறத்துப்பால்",
    "chapter": "கடவுள் வாழ்த்து",
    "kural_no": 6,
    "lines": [
      "பொறிவாயில் ஐந்தவித்தான் பொய்தீர் ஒழுக்க",
      "நெறிநின்றார் நீடுவாழ் வார்"
    ]
  },
  {
    "source_group_id": "TIRUKKURAL_CH01_K007",
    "work": "Tirukkural",
    "section": "அறத்துப்பால்",
    "chapter": "கடவுள் வாழ்த்து",
    "kural_no": 7,
    "lines": [
      "தனக்குவமை இல்லாதான் தாள்சேர்ந்தார்க் கல்லால்",
      "மனக்கவலை மாற்றல் அரிது"
    ]
  },
  {
    "source_group_id": "TIRUKKURAL_CH01_K008",
    "work": "Tirukkural",
    "section": "அறத்துப்பால்",
    "chapter": "கடவுள் வாழ்த்து",
    "kural_no": 8,
    "lines": [
      "அறவாழி அந்தணன் தாள்சேர்ந்தார்க் கல்லால்",
      "பிறவாழி நீந்தல் அரிது"
    ]
  },
  {
    "source_group_id": "TIRUKKURAL_CH01_K009",
    "work": "Tirukkural",
    "section": "அறத்துப்பால்",
    "chapter": "கடவுள் வாழ்த்து",
    "kural_no": 9,
    "lines": [
      "கோளிலாப் பொறியின் குணமிலவே எண்குணத்தான்",
      "தாளை வணங்காத் தலை"
    ]
  },
  {
    "source_group_id": "TIRUKKURAL_CH01_K010",
    "work": "Tirukkural",
    "section": "அறத்துப்பால்",
    "chapter": "கடவுள் வாழ்த்து",
    "kural_no": 10,
    "lines": [
      "பிறவிப் பெருங்கடல் நீந்துவர் நீந்தார்",
      "இறைவன் அடிசேரா தார்"
    ]
  },
  {
    "source_group_id": "NALADIYAR_V01",
    "work": "Naladiyar",
    "section": "துறவு",
    "chapter": "செல்வ நிலையாமை",
    "verse_no": 1,
    "lines": [
      "அறுசுவை உண்டி அமர்ந்தில்லாள் ஊட்ட",
      "மறுசிகை நீட்டிய மன்னரும் பின்னை",
      "வறுமை பிணிப்ப வழிகேட்டுக் கொண்டு",
      "சிறுமையும் உற்றாங்கு உண்பர்"
    ]
  },
  {
    "source_group_id": "NALADIYAR_V02",
    "work": "Naladiyar",
    "section": "துறவு",
    "chapter": "செல்வ நிலையாமை",
    "verse_no": 2,
    "lines": [
      "துகிலோடு பொன்னும் துலங்குமணிக் பூணும்",
      "அகிலோடு நாறும் அணிபூண் மார்பர்",
      "பகலில் பலரும் பரவப் பலர்க்கும்",
      "இகழ்வர் தம் இன்னா உடம்பு"
    ]
  },
  {
    "source_group_id": "NALADIYAR_V03",
    "work": "Naladiyar",
    "section": "துறவு",
    "chapter": "இளமை நிலையாமை",
    "verse_no": 3,
    "lines": [
      "நரைவருமென் றெண்ணி நல்லறி வாளர்",
      "குரைவிடை நின்றார் கொளீஇய – விரைவினோடு",
      "அறஞ்செய்யா ராயின் அருந்துயர்க் குற்ற",
      "பிறந்தாராம் என்னா விழுமம்"
    ]
  },
  {
    "source_group_id": "ATHICHUDI_SEC01",
    "work": "Athichudi",
    "author": "Avvaiyar",
    "section": "உயிர் வருக்கம்",
    "lines": [
      "அறஞ்செய விரும்பு",
      "ஆறுவது சினம்",
      "இயல்வது கரவேல்",
      "ஈவது விலக்கேல்",
      "உடையது விளம்பேல்",
      "ஊக்கமது கைவிடேல்",
      "எண்எழுத் திகழேல்",
      "ஏற்ப திகழ்ச்சி",
      "ஐய மிட்டுண்",
      "ஒப்புர வொழுகு",
      "ஓதுவ தொழியேல்",
      "ஔவியம் பேசேல்"
    ]
  },
  {
    "source_group_id": "THOLKAPPIYAM_ELUTHU_01",
    "work": "Tholkappiyam",
    "section": "எழுத்ததிகாரம்",
    "chapter": "நூல்மரபு",
    "sutra_no": 1,
    "lines": [
      "எழுத்தெனப் படுப அகரமுதல் னகர இறுவாய்",
      "முப்பஃ தென்ப சார்ந்துவரன் மரபின்",
      "மூன்றலங் கடையே"
    ]
  },
  {
    "source_group_id": "THOLKAPPIYAM_ELUTHU_02",
    "work": "Tholkappiyam",
    "section": "எழுத்ததிகாரம்",
    "chapter": "நூல்மரபு",
    "sutra_no": 2,
    "lines": [
      "அவைதாம் குற்றியலிகரம் குற்றியலுகரம்",
      "ஆய்தம் என்ற முப்பாற் புள்ளியும்",
      "எழுத்தோ ரன்ன என்மனார் புலவர்"
    ]
  }
]
